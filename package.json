{
  "name": "@twila/credicarro",
  "version": "1.0.0",
  "description": "SDK oficial em Node.js/TypeScript para a API de integração do Credicarro (financiamento e refinanciamento de veículos)",
  "license": "MIT",
  "keywords": [
    "credicarro",
    "financiamento",
    "refinanciamento",
    "sdk",
    "twila"
  ],
  "homepage": "https://github.com/Twila-Digital/twila-credicarro-node-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Twila-Digital/twila-credicarro-node-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Twila-Digital/twila-credicarro-node-sdk/issues"
  },
  "author": "Twila Digital",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=14"
  },
  "sideEffects": true,
  "workspaces": [
    "contract-tests",
    "samples/*"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "abort-controller": "^3.0.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^5.0.0",
    "cockatiel": "^4.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "msw": "^2.15.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
